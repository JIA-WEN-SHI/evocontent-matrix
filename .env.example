# Shared
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_POSTGREST_TIMEOUT_SEC=8
# Optional dedicated HTTP proxy. Blank preserves HTTPX environment/system proxy discovery.
SUPABASE_HTTP_PROXY=
# False disables inherited proxies and SSL_CERT_FILE/SSL_CERT_DIR for Supabase only.
SUPABASE_TRUST_ENV=true

# API service
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
WEBHOOK_SHARED_SECRET=replace-with-hmac-secret
PII_ENCRYPTION_KEY=replace-with-32-byte-base64-fernet-key
AGENT_SERVICE_URL=http://localhost:8100
INTERNAL_SERVICE_TOKEN=

# Agent service
AGENT_HOST=0.0.0.0
AGENT_PORT=8100
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL_DRAFT=openai/gpt-4.1-mini
OPENAI_MODEL_REFLECTION=openai/gpt-4.1
# Optional browser Agent overrides; blank values inherit the existing model provider.
BROWSER_BRIDGE_API_URL=http://127.0.0.1:8000
BROWSER_MODEL_NAME=
BROWSER_MODEL_API_KEY=
BROWSER_MODEL_BASE_URL=
OPENROUTER_SITE_URL=http://localhost:3001
OPENROUTER_APP_NAME=EvoContent Matrix
ANTHROPIC_API_KEY=
MODEL_ROUTER_MODE=multi
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_DRY_RUN=true
PLAYWRIGHT_STORAGE_STATE_PATH=
PLAYWRIGHT_USER_DATA_DIR=
PLAYWRIGHT_SESSION_COOKIES_JSON=
PLAYWRIGHT_PROXY_SERVER=
PLAYWRIGHT_PROXY_USERNAME=
PLAYWRIGHT_PROXY_PASSWORD=
PLAYWRIGHT_ARTIFACTS_DIR=artifacts/playwright
PLAYWRIGHT_PUBLISH_RETRIES=2
PUBLISH_METHOD_ORDER=playwright,mcp
DAILY_HOTSPOT_MAX_PER_QUERY=5
DAILY_COLLECT_LIMIT=20
DAILY_HOTSPOT_QUERIES=日本移民,日本经营管理签证,日本永住,日本留学
DAILY_HOTSPOT_ENABLE_XHS=true
DAILY_XHS_MAX_PER_QUERY=5
DAILY_XHS_HOME_LIMIT=8
DAILY_XHS_WAIT_MS=2400
DAILY_VIEWPOINT_ENABLED=true
DAILY_VIEWPOINT_MAX_PER_QUERY=3
DAILY_VIEWPOINT_COLLECT_LIMIT=8
DAILY_VIEWPOINT_QUERIES=日本移民 观点,日本经营管理签证 劝退,日本移民 避坑,日本留学 真实经历
DAILY_AUTO_APPROVE_PUBLISH=false
ALLOW_AUTO_PUBLISH=false
PUBLISH_GUARD_MODE=manual_only
ORCHESTRATOR_V2_ENABLED=true
UI_V2_ENABLED=true
DAILY_DEFAULT_CHANNEL=xiaohongshu
DAILY_RUN_MAX_ATTEMPTS=2
DAILY_RETRY_BACKOFF_SECONDS=8
DAILY_SCHEDULER_ENABLED=false
DAILY_SCHEDULER_DOMAIN_SLUG=japan_immigration
DAILY_SCHEDULER_HOUR=9
DAILY_SCHEDULER_MINUTE=0
DAILY_SCHEDULER_UTC_OFFSET=+09:00
XHS_MCP_READONLY_ENABLED=false
XHS_MCP_WRITE_ENABLED=false
XHS_MCP_WRITE_TOOL_ALLOWLIST=publish_content,publish_with_video,post_comment_to_feed,reply_comment_in_feed,like_feed,favorite_feed
XHS_MCP_BASE_URL=
XHS_MCP_API_KEY=
XHS_MCP_TIMEOUT_SEC=20
XHS_MCP_SEARCH_TOOL=xhs.search
XHS_MCP_METRICS_TOOL=xhs.post.metrics
XHS_MCP_FEED_TOOL=list_feeds

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_DOMAIN_SLUG=japan_immigration
NEXT_PUBLIC_LANDING_DEMO_FALLBACK=false
