{
  "manifest_version": 3,
  "name": "EvoContent Chrome 连接",
  "version": "1.1.1",
  "description": "将主动授权的小红书公开标签页连接到本机 EvoContent 项目。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": {"service_worker": "service-worker.js"},
  "action": {"default_popup": "popup.html", "default_title": "连接项目"}
}
